{
  "name": "hub-agentes-ia",
  "version": "1.0.0",
  "description": "Template gratuito: seu próprio hub de agentes de IA (Next.js + Supabase + OpenAI) com login, pagamento e painel admin.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/check-client-secrets.mjs",
    "start": "next start",
    "lint": "eslint",
    "setup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/setup.mjs",
    "setup:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/setup.mjs --check",
    "diagnostico": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/diagnostico.mjs",
    "admin:criar": "node scripts/create-admin.mjs",
    "agentes:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/agentes-sync.mjs",
    "webhook:teste": "node scripts/webhook-teste.mjs",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "check:leaks": "node scripts/check-leaks.mjs",
    "demo:dados": "node scripts/demo-data.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "glimm": "^0.3.1",
    "mammoth": "^1.12.3",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "openai": "^7.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
