# ─────────────────────────────────────────────────────────────
#  VARIÁVEIS DE AMBIENTE
#  Jeito fácil: rode `npm run setup` (ele cria o .env.local e pergunta tudo).
#  Jeito manual: copie este arquivo para .env.local e preencha.
#  NUNCA envie o .env.local para o GitHub nem cole numa IA.
# ─────────────────────────────────────────────────────────────

# ── Supabase (banco, login e arquivos) ── docs/03-supabase.md
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA: dá acesso total ao banco. Só no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI (inteligência) ── docs/04-openai.md
# platform.openai.com > API keys
OPENAI_API_KEY=
# Modelo do chat (precisa aparecer em platform.openai.com > Models)
OPENAI_MODEL=gpt-6-luna
# Modelo de transcrição de áudio. Vazio = botão de áudio desativado.
OPENAI_TRANSCRIBE_MODEL=
# Usado só quando a base de um agente passa de ~80 mil tokens (busca por trechos)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Endereço do app ── docs/09-deploy-vercel.md
# Local: http://localhost:3000 · Produção: https://seu-dominio.com.br
# (se usar NEXT_PUBLIC_BASE_PATH, inclua o caminho: https://site.com.br/agentes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opcional: servir o app num subcaminho (ex.: /agentes). Vazio = raiz do domínio.
NEXT_PUBLIC_BASE_PATH=
# Opcional: outros domínios que enviam formulários ao app (Multi-Zones/proxy), separados por vírgula.
ALLOWED_ORIGINS=

# ── Rotina diária (limpeza da lixeira) ── `npm run setup` gera um valor
CRON_SECRET=

# ── Pagamento (opcional) ── docs/08-pagamento.md
# Hubla: URL do webhook = https://SEU-DOMINIO/api/webhooks/hubla
HUBLA_WEBHOOK_TOKEN=
# Só estes produtos liberam acesso (ids separados por vírgula). Vazio = todos.
HUBLA_PRODUCT_IDS=
